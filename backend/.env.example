MODEL_REAL_ENABLED=true
MODEL_TIMEOUT_SECONDS=30

# 标签提取、运营文案：Gemini 2.5 Flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://api.gpt.ge/v1
GEMINI_MODEL_NAME=gemini-2.5-flash

# 图片理解、手部肤色/手型分析：Qwen VL Plus
QWEN_API_KEY=
QWEN_BASE_URL=https://api.gpt.ge/v1
QWEN_VL_MODEL_NAME=qwen-vl-plus

# AI 试戴/合成图：gpt-image-1.5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.gpt.ge/v1
IMAGE_MODEL_NAME=gpt-image-1
IMAGE_GENERATION_ENABLED=false
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://127.0.0.1:8000/static

# 赛题提供的 25 组手图/款式图链接，默认保留在运营侧目录，不迁移数据库
EVAL_DATASET_PATH=../运营侧/命题三美甲评测数据（对外版）.xlsx
DATABASE_PATH=./storage/nail_ai_demo.db
